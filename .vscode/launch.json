{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Mergington WebApp",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "src.app:app",
        "--reload"
      ],
      "env": {
        "ADMIN_USERNAME": "${input:adminUsername}",
        "ADMIN_PASSWORD": "${input:adminPassword}"
      },
      "jinja": true
    }
  ],
  "inputs": [
    {
      "id": "adminUsername",
      "type": "promptString",
      "description": "Initial administrator username",
      "default": "school-admin"
    },
    {
      "id": "adminPassword",
      "type": "promptString",
      "description": "Initial administrator password (at least 12 characters)",
      "password": true
    }
  ]
}
